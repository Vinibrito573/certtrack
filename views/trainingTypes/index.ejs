<!-- This page displays all training types and allows admins to add, edit or delete them -->
<!-- Vinicius Brito -->

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> | CertTrack</title>
  <!-- Bootstrap references for CSS -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <!-- Google Fonts -->
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
</head>

<body class="bg-light" style="font-family: 'Inter', sans-serif;">
  <%- include('../layouts/navbar') %>
  <div class="container mt-4">

    <!-- Page header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
      <h4 class="fw-bold mb-0" style="color: #1a3c2e;">Training Types</h4>
      <a href="/training-types/create" class="btn text-white" style="background-color: #1a3c2e;">+ Add Training Type</a>
    </div>

    <!-- Training types table -->
    <div class="card shadow-sm">
      <div class="card-body p-0">
        <table class="table table-hover mb-0">
          <thead style="background-color: #1a3c2e; color: white;">
            <tr>
              <th class="px-4 py-3">Training Type</th>
              <th class="py-3 text-center">Validity (months)</th>
              <th class="py-3 text-center">Mandatory</th>
              <th class="py-3 text-center">Actions</th>
            </tr>
          </thead>
          <tbody>
            <!-- If no training types registered yet -->
            <% if (trainingTypes.length === 0) { %>
              <tr>
                <td colspan="4" class="text-center text-muted py-4">No training types registered yet.</td>
              </tr>
            <% } else { %>
              <!-- Loop through all training types -->
              <% trainingTypes.forEach((tt, i) => { %>
                <tr>
                  <td class="px-4 py-3 fw-semibold"><%= tt.name %></td>
                  <td class="py-3 text-center"><%= tt.validity_months %> months</td>
                  <!-- Showing mandatory badge -->
                  <td class="py-3 text-center">
                    <% if (tt.mandatory_default) { %>
                      <span class="badge bg-success">Yes</span>
                    <% } else { %>
                      <span class="badge bg-secondary">No</span>
                    <% } %>
                  </td>
                  <td class="py-3 text-center">
                    <!-- Edit button -->
                    <a href="/training-types/edit/<%= tt.id %>" class="btn btn-sm btn-outline-secondary me-1">Edit</a>
                    <!-- Delete button -->
                    <form method="POST" action="/training-types/delete/<%= tt.id %>" style="display:inline;"
                      onsubmit="return confirm('Are you sure you want to delete <%= tt.name %>?')">
                      <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                    </form>
                  </td>
                </tr>
              <% }) %>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <!-- Bootstrap JS -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>