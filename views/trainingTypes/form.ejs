<!-- This form is used for both creating and editing training types -->
<!-- Vinicius Brito -->

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> | CertTrack</title>
  <!-- Bootstrap references for CSS -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <!-- Google Fonts -->
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
</head>

<body class="bg-light" style="font-family: 'Inter', sans-serif;">

  <%- include('../layouts/navbar') %>

  <div class="container mt-4" style="max-width: 600px;">

    <!-- Page header with back button -->
    <div class="d-flex justify-content-between align-items-center mb-4">
      <h4 class="fw-bold mb-0" style="color: #1a3c2e;"><%= title %></h4>
      <a href="/training-types" class="btn btn-outline-secondary btn-sm">← Back</a>
    </div>

    <!-- Form card -->
    <div class="card shadow-sm">
      <div class="card-body p-4">

        <!-- If trainingType exists, we are editing. If not, we are creating -->
        <form method="POST" action="/training-types/<%= trainingType ? 'edit/' + trainingType.id : 'create' %>">

          <!-- Training type name - required field -->
          <div class="mb-3">
            <label class="form-label fw-semibold">Training Type Name <span class="text-danger">*</span></label>
            <input type="text" name="name" class="form-control"
              placeholder="e.g. CSCS Excavator 360"
              value="<%= trainingType ? trainingType.name : '' %>" required>
          </div>
          <!-- Validity in months - required field -->
          <div class="mb-3">
            <label class="form-label fw-semibold">Validity (months) <span class="text-danger">*</span></label>
            <input type="number" name="validity_months" class="form-control" min="1" max="120"
              placeholder="e.g. 36"
              value="<%= trainingType ? trainingType.validity_months : '' %>" required>
            <div class="form-text">How long this certificate is valid for in months.</div>
          </div>

          <!-- Mandatory on all sites checkbox -->
          <div class="mb-3">
            <div class="form-check">
              <input type="checkbox" name="mandatory_default" class="form-check-input" id="mandatory"
                <%= trainingType && trainingType.mandatory_default ? 'checked' : '' %>>
              <label class="form-check-label fw-semibold" for="mandatory">
                Mandatory on all sites by default
              </label>
              <div class="form-text">Check this if this training is required by law on all Irish construction sites.</div>
            </div>
          </div>

          <!-- Submit and cancel buttons -->
          <div class="d-flex justify-content-end gap-2 mt-4">
            <a href="/training-types" class="btn btn-outline-secondary">Cancel</a>
            <!-- Button text changes depending on if creating or editing -->
            <button type="submit" class="btn text-white" style="background-color: #1a3c2e;">
              <%= trainingType ? 'Save Changes' : 'Add Training Type' %>
            </button>
          </div>
        </form>
      </div>
    </div>

  </div>

  <!-- Bootstrap JS -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>